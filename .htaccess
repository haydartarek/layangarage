RewriteEngine On

# Canonical host: redirect www to non-www while preserving the path and query string.
RewriteCond %{HTTP_HOST} ^www\.layangaragebv\.be$ [NC]
RewriteRule ^ https://layangaragebv.be%{REQUEST_URI} [R=301,L,NE]

# Canonical protocol: keep the production domain on HTTPS.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^layangaragebv\.be$ [NC]
RewriteRule ^ https://layangaragebv.be%{REQUEST_URI} [R=301,L,NE]

# Canonical admin gateway: legacy and directory entry URLs go to the login page.
RewriteRule ^admin\.html/?$ /admin/login.html [R=301,L,NE]
RewriteRule ^admin/?$ /admin/login.html [R=301,L,NE]

# Canonical homepage: redirect /index.html to the clean root URL.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://layangaragebv.be/ [R=301,L]

# Legacy WordPress URLs: preserve Google signals from the old site and send users
# to the matching landing-page section instead of a 404.
RewriteRule ^diensten/motordiagnose/?$ https://layangaragebv.be/#service-diagnose [R=301,L,NE]
RewriteRule ^diensten/band-en-wielservices/?$ https://layangaragebv.be/#service-wheels [R=301,L,NE]
RewriteRule ^diensten/remreparatie/?$ https://layangaragebv.be/#service-brakes [R=301,L,NE]
RewriteRule ^verkoop-wagens/?$ https://layangaragebv.be/#cars [R=301,L,NE]
RewriteRule ^onderhoud/?$ https://layangaragebv.be/#maintenance [R=301,L,NE]
RewriteRule ^inventory/(?:fuel|make)/.+/?$ https://layangaragebv.be/#cars [R=301,L,NE]
RewriteRule ^cookiebeleid-eu/?$ https://layangaragebv.be/privacy.html [R=301,L,NE]

# Keep every admin-related response out of search indexes and cached snippets.
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/admin(?:/|$|\.html(?:/|$))" is_admin_url=1
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" env=is_admin_url
</IfModule>
